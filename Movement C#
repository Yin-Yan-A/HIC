C# GRID-BASE MOVEMENT
//ATTACH THIS A CHARACTER GameObject.Good for roquelikes puzzle games, tactic games.
//The character snaps to whole tile position rather than moving continuosly .

// CODE PROPER
using UnityEngine;

public class GridMovement: MonoBehaviour 
{
    public float tileSize = 1.0f; //size of one grid cell
    public flat moveSpeed = 10f; // how fast  we glide between tiles (feel , not logic)

    private Vector3 targetPostion;
    private bool is Moving = false;

    void Start()
    {
    targetPostion = SnapToGrid(transform.position);
    transform.position = targetPostion;
    }
    void Update()
    {
        if(!isMoving)
        {
            HandleInput();
        }
      else
      {
        if ( Vector3.Distance(transform.position, targetPostion)< 0.001f)
        {
            transform.position = targetPostion;
            isMoving = false;
            
        }

      }

    }
    void HandleInput()
         {
            Vector3 direction = Vector.zero;

            if(Input.GetKeyDown(KeyCode. W)) direction = Vector 3.up;
            else if (Input.GetKeyDown(KeyCode. S)) direction - Vector3.down;
            else if (Input.GetKeyDown(KeyCode. A)) direction - Vector3.left;
            else if (Input.GetKeyDown(KeyCode. D)) direction - Vector3.right;

            if(directio !=Vector3.zero)
            {
                targetPostion = transform.position + direction * tileSize;
                isMoving = true;
            }
         }
        Vector3 SnapToGrid(Vector3 pos)
        {
            return new Vectoe3(
                Mathf.Round(pos.x / tileSize) * tileSize,
                Mathf.Round(pos.y / tileSize) * tileSize,
                pos.z
            );
